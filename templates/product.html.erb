<div class="max-w-6xl mx-auto px-6 py-12">

  <!-- Header -->
  <div class="mb-10">
    <p class="text-sm font-semibold uppercase tracking-wide mb-1" style="color:#e8392d;"><%= t(:product_overview_label) %></p>
    <h1 class="text-4xl font-bold text-gray-900 mb-3"><%= h(product_content[:name]) %></h1>
    <p class="text-xl text-gray-500"><%= h(product_content[:tagline]) %></p>
  </div>

  <!-- What it does -->
  <section class="mb-8">
    <h2 class="text-lg font-semibold text-gray-800 mb-2"><%= t(:what_it_does) %></h2>
    <p class="text-gray-600 leading-relaxed"><%= h(product_content[:description]) %></p>
  </section>

  <!-- Supported Platforms -->
  <% if present?(product_content[:platforms]) %>
    <section class="mb-10">
      <h2 class="text-lg font-semibold text-gray-800 mb-4"><%= t(:supported_platforms) %></h2>
      <div class="flex flex-wrap gap-8 items-center">
        <% product_content[:platforms].each do |platform| %>
          <div class="flex flex-col items-center gap-1.5" style="min-width:64px;">
            <img src="<%= platform[:icon_url] %>" alt="<%= h(platform[:name]) %>" class="w-8 h-8 object-contain" />
            <span class="text-gray-400 text-center" style="font-size:11px;"><%= h(platform[:name]) %></span>
          </div>
        <% end %>
      </div>
      <% if present?(product_content[:platforms_note]) %>
        <p class="text-sm text-gray-400 mt-4">
          <a href="<%= product_content[:platforms_note][:url] %>" target="_blank" class="hover:underline" style="color:#e8392d;"><%= h(product_content[:platforms_note][:text]) %> →</a>
        </p>
      <% end %>
    </section>
  <% end %>

  <!-- Key Features -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold text-gray-800 mb-4"><%= t(:key_features) %></h2>

    <% if product_content[:features].is_a?(Hash) %>

      <%# Tabbed layout %>
      <div id="feature-tabs">

        <%# Tab buttons %>
        <div class="flex flex-wrap border-b border-gray-200 mb-6">
          <% product_content[:features].each_with_index do |(key, feature), index| %>
            <button
              onclick="showTab(<%= index %>)"
              id="tab-btn-<%= index %>"
              class="px-5 py-3 text-sm bg-transparent border-0 cursor-pointer border-b-2 border-transparent text-gray-500 font-medium">
              <%= h(feature[:title]) %>
            </button>
          <% end %>
        </div>

        <%# Tab panels %>
        <% product_content[:features].each_with_index do |(key, feature), index| %>
          <div id="tab-panel-<%= index %>" class="hidden">
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden card-hover">
              <div class="flex flex-wrap items-stretch">

                <%# Image — left on wide screens, top on narrow %>
                <% if present?(feature[:image]) %>
                  <div class="bg-gray-50 border-r border-gray-100 p-6 flex items-center justify-center" style="flex:2 1 520px; height:360px;">
                    <img src="<%= asset(feature[:image]) %>" alt="<%= h(feature[:title]) %>" class="w-full h-full object-contain rounded-md block" />
                  </div>
                <% end %>

                <%# Text — right on wide screens, below on narrow %>
                <div class="p-8" style="flex:1 1 280px;">
                  <h3 class="text-lg font-semibold text-gray-900 mb-3"><%= h(feature[:title]) %></h3>
                  <% if present?(feature[:description]) %>
                    <p class="text-sm text-gray-500 leading-relaxed mb-3"><%= h(feature[:description]) %></p>
                  <% end %>
                  <% if present?(feature[:link_url]) %>
                    <a href="<%= feature[:link_url] %>" target="_blank" class="text-sm font-medium no-underline" style="color:#e8392d;">→ <%= h(feature[:link_title]) %></a>
                  <% end %>
                  <% if present?(feature[:points]) %>
                    <div class="flex flex-col gap-3 mt-2">
                      <% feature[:points].each do |point| %>
                        <div>
                          <% if present?(point[:url]) %>
                            <a href="<%= point[:url] %>" target="_blank" class="text-sm font-semibold no-underline" style="color:#e8392d;">→ <%= h(point[:title]) %></a>
                          <% else %>
                            <span class="text-sm font-semibold text-gray-700"><%= h(point[:title]) %></span>
                          <% end %>
                          <p class="text-sm text-gray-500 mt-0.5 mb-0"><%= h(point[:text]) %></p>
                          <% if present?(point[:sub_points]) %>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-3">
                              <% point[:sub_points].each do |sub| %>
                                <div class="bg-gray-50 rounded-lg p-3">
                                  <% if present?(sub[:url]) %>
                                    <a href="<%= sub[:url] %>" target="_blank" class="text-xs font-semibold uppercase tracking-wide mb-1 no-underline hover:underline block" style="color:#e8392d;"><%= h(sub[:title]) %> →</a>
                                  <% else %>
                                    <p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color:#e8392d;"><%= h(sub[:title]) %></p>
                                  <% end %>
                                  <p class="text-sm text-gray-600 mb-0 leading-snug"><%= h(sub[:text]) %></p>
                                </div>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>

              </div>
            </div>
          </div>
        <% end %>

      </div>

      <script>
        function showTab(activeIndex) {
          const totalTabs = <%= product_content[:features].size %>;
          for (let i = 0; i < totalTabs; i++) {
            const panel = document.getElementById('tab-panel-' + i);
            const btn = document.getElementById('tab-btn-' + i);
            if (i === activeIndex) {
              panel.classList.remove('hidden');
              btn.style.borderBottom = '2px solid #e8392d';
              btn.style.color = '#e8392d';
              btn.style.fontWeight = '600';
            } else {
              panel.classList.add('hidden');
              btn.style.borderBottom = '2px solid transparent';
              btn.style.color = '#6b7280';
              btn.style.fontWeight = '500';
            }
          }
        }
        document.addEventListener('DOMContentLoaded', function() { showTab(0); });
      </script>

    <% else %>

      <ul class="flex flex-col gap-2">
        <% product_content[:features].each do |feature| %>
          <li class="flex items-start gap-2 text-sm text-gray-600">
            <span class="mt-0.5" style="color:#e8392d;">&#10003;</span>
            <%= h(feature) %>
          </li>
        <% end %>
      </ul>

    <% end %>
  </section>

  <!-- Demo Servers -->
  <% if present?(product_content[:demo_servers]) %>
    <section class="mb-10">
      <h2 class="text-lg font-semibold text-gray-800 mb-1"><%= t(:demo_servers) %></h2>
      <p class="text-sm text-gray-500 mb-4">
        <%
          online_demo_link = %(<a href="https://monitor.red-gate.com" target="_blank" class="hover:underline" style="color:#e8392d;">#{h(t(:online_demo_link_text))}</a>)
        %>
        <%= t(:demo_servers_intro, link: online_demo_link) %>
      </p>
      <div class="grid grid-cols-3 gap-x-5 gap-y-4">
        <% product_content[:demo_servers].each do |server| %>
          <a href="<%= server[:url] %>" target="_blank" class="block bg-white border border-gray-200 rounded-xl px-6 py-5 card-hover group">
            <p class="text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:#e8392d;"><%= h(server[:platform]) %></p>
            <p class="text-sm text-gray-700 font-medium"><%= h(server[:name]) %></p>
          </a>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Useful Links -->
  <% if present?(product_content[:links]) %>
    <section class="mb-10">
      <h2 class="text-lg font-semibold text-gray-800 mb-3"><%= t(:useful_links) %></h2>
      <ul class="space-y-2">
        <% product_content[:links].each do |link| %>
          <li>
            <a href="<%= link[:url] %>" target="_blank" class="text-sm font-medium hover:underline" style="color:#e8392d;">
              → <%= h(link[:title]) %>
            </a>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <!-- What's New -->
  <% if releases && present?(releases[:items]) %>
    <section class="mb-10">
      <div class="flex items-baseline gap-3 mb-3">
        <h2 class="text-lg font-semibold text-gray-800"><%= t(:whats_new) %></h2>
        <% if present?(releases[:items]) %>
          <% newest = releases[:items].first[:date] %>
          <% oldest = releases[:items].last[:date] %>
          <span class="text-xs text-gray-400"><%= oldest == newest ? newest : "#{oldest} – #{newest}" %></span>
        <% end %>
      </div>

      <% if present?(releases[:summary]) %>
        <p class="text-gray-600 leading-relaxed mb-6 [&_a]:text-[#e8392d] [&_a]:font-medium [&_a]:hover:underline"><%= sanitize_summary(releases[:summary]) %></p>
      <% end %>

      <div class="flex flex-col gap-4">
        <% releases[:items].each_with_index do |release, index| %>
          <div class="bg-white border border-gray-200 rounded-xl p-6 <%= index >= 5 ? 'hidden release-extra' : '' %>">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-gray-900">v<%= h(release[:version]) %></span>
                <span class="text-sm text-gray-400"><%= h(release[:date]) %></span>
              </div>
              <a href="<%= release[:docs_url] %>" target="_blank" class="text-xs font-medium hover:underline" style="color:#e8392d;">
                <%= t(:full_release_notes) %>
              </a>
            </div>
            <ul class="flex flex-col gap-1.5">
              <% release[:highlights].each do |highlight| %>
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="mt-0.5" style="color:#e8392d;">&#10003;</span>
                  <%= h(highlight) %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>

      <% if releases[:items].length > 5 %>
        <button
          id="show-more-releases"
          onclick="toggleReleases()"
          class="mt-4 text-sm font-medium hover:underline bg-transparent border-0 cursor-pointer p-0"
          style="color:#e8392d;"
          data-more-text="<%= h(t(:show_older_releases, count: releases[:items].length - 5)) %>"
          data-fewer-text="<%= h(t(:show_fewer_releases)) %>">
          <%= t(:show_older_releases, count: releases[:items].length - 5) %>
        </button>
        <script>
          function toggleReleases() {
            const extras = document.querySelectorAll('.release-extra');
            const btn = document.getElementById('show-more-releases');
            const hidden = extras[0].classList.contains('hidden');
            extras.forEach(el => el.classList.toggle('hidden', !hidden));
            btn.textContent = hidden ? btn.dataset.fewerText : btn.dataset.moreText;
          }
        </script>
      <% end %>

      <% if present?(releases[:fetched_at]) %>
        <p class="text-xs text-gray-400 mt-3">
          <%= t(:last_updated, date: h(releases[:fetched_at])) %>
          <% oldest = releases[:items].last %>
          <% if oldest %>
            · <%= t(:showing_changes_back_to, date: h(oldest[:date])) %>
          <% end %>
        </p>
      <% end %>
    </section>
  <% end %>

  <!-- Back link -->
  <a href="<%= page_path(locale, :home) %>" class="text-sm font-medium hover:underline" style="color:#e8392d;"><%= t(:back_to_all_products) %></a>

</div>

<div class="max-w-4xl mx-auto px-6 py-12">

  <!-- Header -->
  <div class="mb-10">
    <p class="text-sm text-red-600 font-semibold uppercase tracking-wide mb-1">Product Overview</p>
    <h1 class="text-4xl font-bold text-gray-900 mb-3"><%= @content[:name] %></h1>
    <p class="text-xl text-gray-500"><%= @content[:tagline] %></p>
  </div>

  <!-- What it does -->
  <section class="mb-8">
    <h2 class="text-lg font-semibold text-gray-800 mb-2">What it does</h2>
    <p class="text-gray-600 leading-relaxed"><%= @content[:description] %></p>
  </section>

  <!-- Key Features -->
  <section class="mb-8">
  <h2 class="text-lg font-semibold text-gray-800 mb-4">Key Features</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% @content[:features].each do |key, feature| %>
      <div class="bg-white border border-gray-200 rounded-xl p-6">
        <h3 class="font-semibold text-gray-900 mb-2"><%= feature[:title] %></h3>
        <p class="text-sm text-gray-500 mb-4"><%= feature[:description] %></p>
        <div style="width:100%; height:160px; background:#f3f4f6; border-radius:8px; display:flex; align-items:center; justify-content:center;">
          <span style="font-size:12px; color:#9ca3af;">Screenshot coming soon</span>
        </div>
      </div>
    <% end %>
  </div>
</section>

  <!-- Supported Platforms -->
  <% if @content[:platforms].present? %>
    <section class="mb-8">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Supported Platforms</h2>
      <div style="display:flex; gap:32px; align-items:center; flex-wrap:wrap;">
        <% @content[:platforms].each do |platform| %>
          <div style="display:flex; flex-direction:column; align-items:center; gap:6px; min-width:64px;">
            <img src="<%= platform[:icon_url] %>" alt="<%= platform[:name] %>" style="width:32px; height:32px; object-fit:contain;" />
            <span style="font-size:11px; color:#6b7280; text-align:center;"><%= platform[:name] %></span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Who it's for -->
  <section class="mb-8">
    <h2 class="text-lg font-semibold text-gray-800 mb-2">Who it's for</h2>
    <p class="text-gray-600"><%= @content[:audience] %></p>
  </section>

  <!-- Useful Links -->
  <% if @content[:links].present? %>
    <section class="mb-8">
      <h2 class="text-lg font-semibold text-gray-800 mb-3">Useful Links</h2>
      <ul class="space-y-2">
        <% @content[:links].each do |link| %>
          <li>
            <a href="<%= link[:url] %>" target="_blank" class="text-red-600 hover:underline text-sm font-medium">
              → <%= link[:title] %>
            </a>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <!-- Why Redgate -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold text-gray-800 mb-2">Why Redgate</h2>
    <p class="text-gray-600"><%= @content[:why_redgate] %></p>
  </section>

  <!-- Back link -->
  <%= link_to "← Back to all products", root_path, class: "text-red-600 hover:underline text-sm font-medium" %>

</div>
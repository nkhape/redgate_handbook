<div class="max-w-6xl mx-auto px-6 py-12">

  <!-- Header -->
  <div class="mb-10">
    <p class="text-sm font-semibold uppercase tracking-wide mb-1" style="color:#e8392d;">Product Overview</p>
    <h1 class="text-4xl font-bold text-gray-900 mb-3"><%= @content[:name] %></h1>
    <p class="text-xl text-gray-500"><%= @content[:tagline] %></p>
  </div>

  <!-- What it does -->
  <section class="mb-8">
    <h2 class="text-lg font-semibold text-gray-800 mb-2">What it does</h2>
    <p class="text-gray-600 leading-relaxed"><%= @content[:description] %></p>
  </section>

  <!-- Supported Platforms -->
  <% if @content[:platforms].present? %>
    <section class="mb-10">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Supported Platforms</h2>
      <div class="flex flex-wrap gap-8 items-center">
        <% @content[:platforms].each do |platform| %>
          <div class="flex flex-col items-center gap-1.5" style="min-width:64px;">
            <img src="<%= platform[:icon_url] %>" alt="<%= platform[:name] %>" class="w-8 h-8 object-contain" />
            <span class="text-gray-400 text-center" style="font-size:11px;"><%= platform[:name] %></span>
          </div>
        <% end %>
      </div>
      <% if @content[:platforms_note].present? %>
        <p class="text-sm text-gray-400 mt-4">
          <a href="<%= @content[:platforms_note][:url] %>" target="_blank" class="hover:underline" style="color:#e8392d;"><%= @content[:platforms_note][:text] %> →</a>
        </p>
      <% end %>
    </section>
  <% end %>

  <!-- Key Features -->
  <section class="mb-10">
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Key Features</h2>

    <% if @content[:features].is_a?(Hash) %>

      <%# Tabbed layout %>
      <div id="feature-tabs">

        <%# Tab buttons %>
        <div class="flex flex-wrap border-b border-gray-200 mb-6">
          <% @content[:features].each_with_index do |(key, feature), index| %>
            <button
              onclick="showTab(<%= index %>)"
              id="tab-btn-<%= index %>"
              class="px-5 py-3 text-sm bg-transparent border-0 cursor-pointer border-b-2 border-transparent text-gray-500 font-medium">
              <%= feature[:title] %>
            </button>
          <% end %>
        </div>

        <%# Tab panels %>
        <% @content[:features].each_with_index do |(key, feature), index| %>
          <div id="tab-panel-<%= index %>" class="hidden">
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden card-hover">
              <div class="flex flex-wrap items-stretch">

                <%# Image — left on wide screens, top on narrow %>
                <% if feature[:image].present? %>
                  <div class="bg-gray-50 border-r border-gray-100 p-6" style="flex:2 1 520px;">
                    <img src="<%= feature[:image] %>" alt="<%= feature[:title] %>" class="w-full rounded-md block" />
                  </div>
                <% end %>

                <%# Text — right on wide screens, below on narrow %>
                <div class="p-8" style="flex:1 1 280px;">
                  <h3 class="text-lg font-semibold text-gray-900 mb-3"><%= feature[:title] %></h3>
                  <% if feature[:description].present? %>
                    <p class="text-sm text-gray-500 leading-relaxed mb-3"><%= feature[:description] %></p>
                  <% end %>
                  <% if feature[:link_url].present? %>
                    <a href="<%= feature[:link_url] %>" target="_blank" class="text-sm font-medium no-underline" style="color:#e8392d;">→ <%= feature[:link_title] %></a>
                  <% end %>
                  <% if feature[:points].present? %>
                    <div class="flex flex-col gap-3 mt-2">
                      <% feature[:points].each do |point| %>
                        <div>
                          <% if point[:url].present? %>
                            <a href="<%= point[:url] %>" target="_blank" class="text-sm font-semibold no-underline" style="color:#e8392d;">→ <%= point[:title] %></a>
                          <% else %>
                            <span class="text-sm font-semibold text-gray-700"><%= point[:title] %></span>
                          <% end %>
                          <p class="text-sm text-gray-500 mt-0.5 mb-0"><%= point[:text] %></p>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>

              </div>
            </div>
          </div>
        <% end %>

      </div>

      <script>
        function showTab(activeIndex) {
          const totalTabs = <%= @content[:features].size %>;
          for (let i = 0; i < totalTabs; i++) {
            const panel = document.getElementById('tab-panel-' + i);
            const btn = document.getElementById('tab-btn-' + i);
            if (i === activeIndex) {
              panel.classList.remove('hidden');
              btn.style.borderBottom = '2px solid #e8392d';
              btn.style.color = '#e8392d';
              btn.style.fontWeight = '600';
            } else {
              panel.classList.add('hidden');
              btn.style.borderBottom = '2px solid transparent';
              btn.style.color = '#6b7280';
              btn.style.fontWeight = '500';
            }
          }
        }
        document.addEventListener('DOMContentLoaded', function() { showTab(0); });
        document.addEventListener('turbo:load', function() { showTab(0); });
      </script>

    <% else %>

      <ul class="flex flex-col gap-2">
        <% @content[:features].each do |feature| %>
          <li class="flex items-start gap-2 text-sm text-gray-600">
            <span class="mt-0.5" style="color:#e8392d;">&#10003;</span>
            <%= feature %>
          </li>
        <% end %>
      </ul>

    <% end %>
  </section>

  <!-- Demo Servers -->
  <% if @content[:demo_servers].present? %>
    <section class="mb-10">
      <h2 class="text-lg font-semibold text-gray-800 mb-1">Demo Servers</h2>
      <p class="text-sm text-gray-500 mb-4">Use these on the <a href="https://monitor.red-gate.com" target="_blank" class="hover:underline" style="color:#e8392d;">online demo</a> — you can't break anything!</p>
      <div class="grid grid-cols-3 gap-x-5 gap-y-4">
        <% @content[:demo_servers].each do |server| %>
          <a href="<%= server[:url] %>" target="_blank" class="block bg-white border border-gray-200 rounded-xl px-6 py-5 card-hover group">
            <p class="text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:#e8392d;"><%= server[:platform] %></p>
            <p class="text-sm text-gray-700 font-medium"><%= server[:name] %></p>
          </a>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Useful Links -->
  <% if @content[:links].present? %>
    <section class="mb-10">
      <h2 class="text-lg font-semibold text-gray-800 mb-3">Useful Links</h2>
      <ul class="space-y-2">
        <% @content[:links].each do |link| %>
          <li>
            <a href="<%= link[:url] %>" target="_blank" class="text-sm font-medium hover:underline" style="color:#e8392d;">
              → <%= link[:title] %>
            </a>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <!-- What's New -->
  <% if @releases&.dig(:items).present? %>
    <section class="mb-10">
      <div class="flex items-baseline gap-3 mb-3">
        <h2 class="text-lg font-semibold text-gray-800">What's New</h2>
        <% if @releases[:items].present? %>
          <% newest = @releases[:items].first[:date] %>
          <% oldest = @releases[:items].last[:date] %>
          <span class="text-xs text-gray-400"><%= oldest == newest ? newest : "#{oldest} – #{newest}" %></span>
        <% end %>
      </div>

      <% if @releases[:summary].present? %>
        <p class="text-gray-600 leading-relaxed mb-6 [&_a]:text-[#e8392d] [&_a]:font-medium [&_a]:hover:underline"><%= sanitize(@releases[:summary], tags: %w[a], attributes: %w[href target]) %></p>
      <% end %>

      <div class="flex flex-col gap-4">
        <% @releases[:items].each_with_index do |release, index| %>
          <div class="bg-white border border-gray-200 rounded-xl p-6 <%= index >= 5 ? 'hidden release-extra' : '' %>">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-gray-900">v<%= release[:version] %></span>
                <span class="text-sm text-gray-400"><%= release[:date] %></span>
              </div>
              <a href="<%= release[:docs_url] %>" target="_blank" class="text-xs font-medium hover:underline" style="color:#e8392d;">
                Full release notes →
              </a>
            </div>
            <ul class="flex flex-col gap-1.5">
              <% release[:highlights].each do |highlight| %>
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="mt-0.5" style="color:#e8392d;">&#10003;</span>
                  <%= highlight %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>

      <% if @releases[:items].length > 5 %>
        <button
          id="show-more-releases"
          onclick="toggleReleases()"
          class="mt-4 text-sm font-medium hover:underline bg-transparent border-0 cursor-pointer p-0"
          style="color:#e8392d;">
          Show <%= @releases[:items].length - 5 %> older releases ↓
        </button>
        <script>
          function toggleReleases() {
            const extras = document.querySelectorAll('.release-extra');
            const btn = document.getElementById('show-more-releases');
            const hidden = extras[0].classList.contains('hidden');
            extras.forEach(el => el.classList.toggle('hidden', !hidden));
            btn.textContent = hidden
              ? 'Show fewer releases ↑'
              : 'Show <%= @releases[:items].length - 5 %> older releases ↓';
          }
        </script>
      <% end %>

      <% if @releases[:fetched_at].present? %>
        <p class="text-xs text-gray-400 mt-3">
          Last updated <%= @releases[:fetched_at] %>
          <% oldest = @releases[:items].last %>
          <% if oldest %>
            · Showing changes back to <%= oldest[:date] %>
          <% end %>
        </p>
      <% end %>
    </section>
  <% end %>

  <!-- Back link -->
  <%= link_to "← Back to all products", root_path, class: "text-sm font-medium hover:underline", style: "color:#e8392d;" %>

</div>

<div class="max-w-6xl mx-auto px-6 py-12">

  <!-- Header -->
  <div class="mb-10">
    <p class="text-sm text-red-600 font-semibold uppercase tracking-wide mb-1">Product Overview</p>
    <h1 class="text-4xl font-bold text-gray-900 mb-3"><%= @content[:name] %></h1>
    <p class="text-xl text-gray-500"><%= @content[:tagline] %></p>
  </div>

  <!-- What it does -->
  <section class="mb-8">
    <h2 class="text-lg font-semibold text-gray-800 mb-2">What it does</h2>
    <p class="text-gray-600 leading-relaxed"><%= @content[:description] %></p>
  </section>

  <!-- Supported Platforms -->
  <% if @content[:platforms].present? %>
    <section class="mb-8">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Supported Platforms</h2>
      <div class="flex flex-wrap gap-8 items-center">
        <% @content[:platforms].each do |platform| %>
          <div class="flex flex-col items-center gap-1.5" style="min-width:64px;">
            <img src="<%= platform[:icon_url] %>" alt="<%= platform[:name] %>" class="w-8 h-8 object-contain" />
            <span class="text-gray-500 text-center" style="font-size:11px;"><%= platform[:name] %></span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Key Features -->
  <section class="mb-8">
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Key Features</h2>

    <% if @content[:features].is_a?(Hash) %>

      <%# Tabbed layout %>
      <div id="feature-tabs">

        <%# Tab buttons %>
        <div class="flex flex-wrap border-b border-gray-200 mb-6">
          <% @content[:features].each_with_index do |(key, feature), index| %>
            <button
              onclick="showTab(<%= index %>)"
              id="tab-btn-<%= index %>"
              class="px-5 py-3 text-sm bg-transparent border-0 cursor-pointer border-b-2 border-transparent text-gray-500">
              <%= feature[:title] %>
            </button>
          <% end %>
        </div>

        <%# Tab panels %>
        <% @content[:features].each_with_index do |(key, feature), index| %>
          <div id="tab-panel-<%= index %>" class="hidden">
            <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
              <div class="flex flex-wrap items-stretch">

                <%# Image — left on wide screens, top on narrow %>
                <% if feature[:image].present? %>
                  <div class="bg-gray-50 border-r border-gray-100 p-6" style="flex:2 1 520px;">
                    <img src="<%= feature[:image] %>" alt="<%= feature[:title] %>" class="w-full rounded-md block" />
                  </div>
                <% end %>

                <%# Text — right on wide screens, below on narrow %>
                <div class="p-8" style="flex:1 1 280px;">
                  <h3 class="text-lg font-semibold text-gray-900 mb-3"><%= feature[:title] %></h3>
                  <% if feature[:description].present? %>
                    <p class="text-sm text-gray-500 leading-relaxed mb-3"><%= feature[:description] %></p>
                  <% end %>
                  <% if feature[:link_url].present? %>
                    <a href="<%= feature[:link_url] %>" target="_blank" class="text-sm text-red-600 font-medium no-underline">→ <%= feature[:link_title] %></a>
                  <% end %>
                  <% if feature[:points].present? %>
                    <div class="flex flex-col gap-3 mt-2">
                      <% feature[:points].each do |point| %>
                        <div>
                          <% if point[:url].present? %>
                            <a href="<%= point[:url] %>" target="_blank" class="text-sm font-semibold text-red-600 no-underline"><%= point[:title] %> →</a>
                          <% else %>
                            <span class="text-sm font-semibold text-gray-700"><%= point[:title] %></span>
                          <% end %>
                          <p class="text-sm text-gray-500 mt-0.5 mb-0"><%= point[:text] %></p>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>

              </div>
            </div>
          </div>
        <% end %>

      </div>

      <script>
        function showTab(activeIndex) {
          const totalTabs = <%= @content[:features].size %>;
          for (let i = 0; i < totalTabs; i++) {
            const panel = document.getElementById('tab-panel-' + i);
            const btn = document.getElementById('tab-btn-' + i);
            if (i === activeIndex) {
              panel.classList.remove('hidden');
              btn.style.borderBottom = '2px solid #dc2626';
              btn.style.color = '#dc2626';
              btn.style.fontWeight = '600';
            } else {
              panel.classList.add('hidden');
              btn.style.borderBottom = '2px solid transparent';
              btn.style.color = '#6b7280';
              btn.style.fontWeight = '500';
            }
          }
        }
        document.addEventListener('DOMContentLoaded', function() { showTab(0); });
      </script>

    <% else %>

      <%# Simple bullet list for products not yet updated %>
      <ul class="flex flex-col gap-2">
        <% @content[:features].each do |feature| %>
          <li class="flex items-start gap-2 text-sm text-gray-600">
            <span class="text-red-400 mt-0.5">&#10003;</span>
            <%= feature %>
          </li>
        <% end %>
      </ul>

    <% end %>
  </section>

  <!-- Demo Servers -->
  <% if @content[:demo_servers].present? %>
    <section class="mb-8">
      <h2 class="text-lg font-semibold text-gray-800 mb-1">Demo Servers</h2>
      <p class="text-sm text-gray-500 mb-4">Use these on the <a href="https://monitor.red-gate.com" target="_blank" class="text-red-600 hover:underline">online demo</a> — you can't break anything!</p>
      <div class="grid grid-cols-3 gap-x-5 gap-y-4">
        <% @content[:demo_servers].each do |server| %>
          <a href="<%= server[:url] %>" target="_blank" class="block bg-white border border-gray-200 rounded-xl px-6 py-5 hover:border-red-400 hover:shadow-sm transition-all group">
            <p class="text-xs text-red-600 font-semibold uppercase tracking-wide mb-1.5"><%= server[:platform] %></p>
            <p class="text-sm text-gray-700 font-medium group-hover:text-red-600"><%= server[:name] %></p>
          </a>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Useful Links -->
  <% if @content[:links].present? %>
    <section class="mb-8">
      <h2 class="text-lg font-semibold text-gray-800 mb-3">Useful Links</h2>
      <ul class="space-y-2">
        <% @content[:links].each do |link| %>
          <li>
            <a href="<%= link[:url] %>" target="_blank" class="text-sm text-red-600 font-medium hover:underline">
              → <%= link[:title] %>
            </a>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <!-- Back link -->
  <%= link_to "← Back to all products", root_path, class: "text-sm text-red-600 font-medium hover:underline" %>

</div>

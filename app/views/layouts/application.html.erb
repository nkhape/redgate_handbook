<!DOCTYPE html>
<html>
  <head>
    <title>Redgate Handbook</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-white min-h-screen font-sans antialiased">

    <!-- Navbar -->
    <nav class="bg-[#111827] text-white px-6 py-4 flex items-center justify-between">
      <%= link_to root_path, class: "text-white font-semibold text-lg tracking-tight hover:text-[#e8392d] transition" do %>
        <span class="text-[#e8392d]">Redgate</span> Handbook
      <% end %>

      <div class="flex gap-6 text-sm font-medium">
        <% [["Monitor", "monitor"], ["Flyway", "flyway"], ["Test Data Manager", "test_data_manager"], ["Toolbelt Essentials", "toolbelt_essentials"]].each do |label, key| %>
          <%= link_to label, product_path(product: key), class: "transition hover:underline #{@product == key ? 'text-white underline' : 'text-gray-300 hover:text-white'}", style: "text-decoration-color:#e8392d;" %>
        <% end %>
      </div>
    </nav>

    <main>
      <%= yield %>
    </main>

  </body>
</html>

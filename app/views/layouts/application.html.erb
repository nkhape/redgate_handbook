<!DOCTYPE html>
<html>
  <head>
    <title>Redgate Handbook</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
</head>
  <body class="bg-gray-50 min-h-screen">

    <!-- Navbar -->
    <nav class="bg-[#1a1a2e] text-white px-6 py-4 flex items-center justify-between">
      <%= link_to root_path, class: "text-white font-bold text-lg tracking-tight hover:text-red-400 transition" do %>
        <span class="text-red-500">Redgate</span> Handbook
      <% end %>

      <div class="flex gap-4 text-sm">
        <%= link_to "Flyway", product_path(product: "flyway"), class: "hover:text-red-400 transition" %>
        <%= link_to "Monitor", product_path(product: "monitor"), class: "hover:text-red-400 transition" %>
        <%= link_to "Test Data Manager", product_path(product: "test_data_manager"), class: "hover:text-red-400 transition" %>
        <%= link_to "Toolbelt Essentials", product_path(product: "toolbelt_essentials"), class: "hover:text-red-400 transition" %>
      </div>
    </nav>

    <main>
      <%= yield %>
    </main>

  </body>
</html>